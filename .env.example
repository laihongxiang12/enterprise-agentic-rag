APP_ENV=local
APP_MODE=fake
LOG_LEVEL=INFO
BIND_HOST=127.0.0.1

# Local-only signed demo authentication. Use at least 32 random characters.
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
DEV_AUTH_ISSUER=enterprise-agentic-rag-dev
DEV_AUTH_AUDIENCE=enterprise-agentic-rag

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_STRUCTURED_OUTPUT_MODE=json_schema
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=4
LLM_MAX_CALLS=12
LLM_MAX_TOTAL_TOKENS=
LLM_MAX_OUTPUT_TOKENS=1024
# Optional and intentionally separate from code; set both or neither.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Local PostgreSQL Compose settings. Replace the example password in .env.
POSTGRES_USER=rag_test
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_DB=enterprise_agentic_rag_test
DATABASE_URL=postgresql://rag_test:replace-with-a-local-random-password@127.0.0.1:5432/enterprise_agentic_rag_test
TEST_DATABASE_URL=postgresql://rag_test:replace-with-a-local-random-password@127.0.0.1:5432/enterprise_agentic_rag_test
REDIS_URL=
MILVUS_URI=http://127.0.0.1:19530
TEST_MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=enterprise_rag_hybrid_chunks
EMBEDDING_DIMENSION=128
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_LEXICAL_TOP_K=30
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSION_TOP_K=20
RERANKER_CANDIDATE_LIMIT=20
RERANKER_TOP_K=8
RERANKER_TIMEOUT_SECONDS=2.0
CONTEXT_TOKEN_BUDGET=1200
CONTEXT_MAX_PARENTS=8
